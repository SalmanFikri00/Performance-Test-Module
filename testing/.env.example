# Alamat dasar server Orange Pi; tanpa path akhir.
BASE_URL=http://192.168.1.50:3000

# Tahap warm-up dan puncak (default PRD: 300 lalu 1000 VU, masing-masing 15 detik).
WARMUP_VUS=300
WARMUP_DURATION=15s
PEAK_VUS=1000
PEAK_DURATION=15s

# Nama executable k6, atau path lengkap jika tidak ada di PATH.
K6_BIN=k6
